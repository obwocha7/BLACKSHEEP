# ========== TELEGRAM ==========
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_SESSION_NAME=tg_mt5_session
TG_ALLOWED_CHAT=@your_channel_or_numeric_id

# ========== MT5 ==========
MT5_LOGIN=0
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Server
MT5_PATH=
MT5_SYMBOL=auto
MT5_MAGIC=260617

# ========== RISK ==========
RISK_MODE=percent
RISK_PERCENT=1.0
FIXED_LOT=0.02
MAX_CONCURRENT_SIGNALS=5
DEFAULT_SOFT_PARTIAL_PERCENT=25
TP1_CLOSE_PERCENT=50
TP2_CLOSE_PERCENT=100
BE_AFTER_TP1=true
BE_BUFFER_POINTS=20

# ========== EXECUTION ==========
DRY_RUN=true
AUTO_CLOSE_OPPOSITE=true
SLIPPAGE_DEVIATION_POINTS=50
STALE_SIGNAL_MINUTES=120
RECONCILE_INTERVAL_SECONDS=20

# ========== DASHBOARD ==========
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# ========== LOGGING ==========
LOG_LEVEL=INFO
PARSER_TRACE=false
